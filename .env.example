# CareerPilot configuration — copy to .env and fill in.
# Placeholders only. Never commit a real .env.

# ----------------------------------------------------------------------------
# Core
# ----------------------------------------------------------------------------
CAREERPILOT_ENV=development            # development | test | production
CAREERPILOT_DEBUG=true
CAREERPILOT_LOG_LEVEL=INFO             # DEBUG | INFO | WARNING | ERROR
CAREERPILOT_LOG_FORMAT=console         # console | json

# ----------------------------------------------------------------------------
# Security
# ----------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required in production; a development-only default is used otherwise.
CAREERPILOT_SECRET_KEY=replace-me-with-a-long-random-string
CAREERPILOT_ACCESS_TOKEN_TTL_MINUTES=60

# ----------------------------------------------------------------------------
# Database
# ----------------------------------------------------------------------------
# Host port 5433 avoids clashing with a local Postgres on 5432.
CAREERPILOT_DATABASE_URL=postgresql+asyncpg://careerpilot:careerpilot@localhost:5433/careerpilot
# Used by the integration test suite. Tests skip cleanly if unreachable.
CAREERPILOT_TEST_DATABASE_URL=postgresql+asyncpg://careerpilot:careerpilot@localhost:5433/careerpilot_test

# Values the postgres container initialises itself with.
POSTGRES_USER=careerpilot
POSTGRES_PASSWORD=careerpilot
POSTGRES_DB=careerpilot

# ----------------------------------------------------------------------------
# Redis (queues, caching, short-lived task state) — used from Phase 4
# ----------------------------------------------------------------------------
CAREERPILOT_REDIS_URL=redis://localhost:6379/0

# ----------------------------------------------------------------------------
# Storage for resumes, screenshots and browser artefacts.
# Large files live on disk; only metadata and paths go in the database.
# ----------------------------------------------------------------------------
CAREERPILOT_STORAGE_DIR=./var/storage
CAREERPILOT_MAX_UPLOAD_BYTES=5242880

# ----------------------------------------------------------------------------
# Frontend
# ----------------------------------------------------------------------------
CAREERPILOT_CORS_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000

# ----------------------------------------------------------------------------
# Matching engine weights. Must sum to 1.0; validated at startup.
# ----------------------------------------------------------------------------
CAREERPILOT_WEIGHT_SKILL_OVERLAP=0.30
CAREERPILOT_WEIGHT_EVIDENCE=0.20
CAREERPILOT_WEIGHT_ROLE_RELEVANCE=0.20
CAREERPILOT_WEIGHT_EDUCATION=0.10
CAREERPILOT_WEIGHT_LOCATION=0.10
CAREERPILOT_WEIGHT_PREFERENCES=0.10

# ----------------------------------------------------------------------------
# LLM provider — Phase 3. Left disabled on purpose.
#
# A Claude Code subscription does NOT grant application-level API access. Enabling a
# provider here means paid API usage, so it stays off until explicitly approved.
# With "none", CareerPilot uses its deterministic no-LLM fallback and stays fully
# functional: scoring, matching and explanations are all rule-based.
# ----------------------------------------------------------------------------
CAREERPILOT_LLM_PROVIDER=none           # none | anthropic | openai
CAREERPILOT_LLM_MODEL=
CAREERPILOT_LLM_API_KEY=

# ----------------------------------------------------------------------------
# Browser agent — Phase 5
# ----------------------------------------------------------------------------
CAREERPILOT_BROWSER_HEADLESS=false      # a human must be able to intervene
CAREERPILOT_BROWSER_TIMEOUT_MS=30000
CAREERPILOT_MAX_VERIFICATION_AGE_SECONDS=900

# ----------------------------------------------------------------------------
# Connector politeness — Phase 2
# ----------------------------------------------------------------------------
CAREERPILOT_CONNECTOR_USER_AGENT=CareerPilot/0.1 (+https://github.com/your-handle/career-pilot)
CAREERPILOT_CONNECTOR_RATE_LIMIT_PER_MINUTE=20
CAREERPILOT_CONNECTOR_MAX_RETRIES=3
